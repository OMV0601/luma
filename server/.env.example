# Copy to server/.env
# With a key: adversaries are live Claude characters.
# Without a key: scripted fallback adversaries run automatically — the full
# demo loop still works offline.
ANTHROPIC_API_KEY=sk-ant-...

PORT=3001
ADVERSARY_MODEL=claude-sonnet-4-6
REFEREE_MODEL=claude-sonnet-4-6
SESSION_SECRET=foolproof-dev-secret

# Optional: Wolfram|Alpha AppID (free at developer.wolframalpha.com).
# With a key: the Evidence File carries an "independently cross-checked"
# badge — the key computation is re-run by Wolfram|Alpha and compared to the
# deterministic engine's number. Without a key: the badge is simply omitted.
WOLFRAM_APP_ID=

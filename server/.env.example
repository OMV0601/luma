# Copy to server/.env
# With a key: adversaries are live Claude characters.
# Without a key: scripted fallback adversaries run automatically — the full
# demo loop still works offline.
ANTHROPIC_API_KEY=sk-ant-...

PORT=3001
ADVERSARY_MODEL=claude-sonnet-4-6
REFEREE_MODEL=claude-sonnet-4-6
SESSION_SECRET=foolproof-dev-secret

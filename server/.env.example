# Copy this file to .env and fill in your key.
# Get one at https://platform.claude.com/ -> API Keys.
# (Alternatively, if you've run `ant auth login`, the SDK picks up that
#  profile automatically and you can leave this unset.)
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
PORT=3001
ADVERSARY_MODEL=claude-opus-4-8
REFEREE_MODEL=claude-opus-4-8
